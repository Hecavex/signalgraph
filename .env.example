# Required before production startup. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-32-random-characters

# Database
POSTGRES_DB=signalgraph
POSTGRES_USER=signalgraph
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DATABASE_URL=postgresql+psycopg://signalgraph:replace-with-a-long-random-database-password@postgres:5432/signalgraph

# Queue and application
REDIS_URL=redis://redis:6379/0
ENVIRONMENT=production
LOG_LEVEL=INFO
ACCESS_TOKEN_MINUTES=60
CORS_ORIGINS=http://localhost:8080

# Optional authenticated collector. It remains disabled until enabled in Operations.
URLSCAN_API_KEY=

# Used only by the optional synthetic demo-data command. Change before any exposed deployment.
DEMO_ADMIN_PASSWORD=replace-with-a-strong-demo-password
